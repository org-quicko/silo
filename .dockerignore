# Keep the build context small and deterministic. The UI is rebuilt inside the
# image, so never ship a local dist or node_modules; the Docker build compiles
# the UI in stage 1 and copies apps/admin/dist into the runtime stage.
.git
.github
.env
.env.*
silo.toml
node_modules
apps/server/test
dist/
silo
silo.exe
silo_data/
*.db
*.db-wal
*.db-shm
apps/admin/node_modules
apps/admin/dist
**/.DS_Store
