{
  "name": "silo",
  "version": "1.0.1",
  "description": "A minimal, self-hostable headless CMS in TypeScript on Bun and Hono",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*", "plugins/*"],
  "scripts": {
    "start": "bun run --cwd apps/server start",
    "dev": "concurrently -n server,admin -c blue,magenta --kill-others \"bun run start --data ./silo_data\" \"bun run --cwd apps/admin dev\"",
    "test": "bun test",
    "lint": "bun run --cwd apps/admin lint",
    "typecheck": "tsc -b && tsc -b apps/admin",
    "build": "bun run tools/build/main.ts",
    "seed": "bun run tools/seed/main.ts",
    "set-version": "bun run tools/set-version.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^20.19.43",
    "@types/tar": "^6.1.13",
    "concurrently": "^10.0.5",
    "tar": "^7.5.22",
    "typescript": "^7.0.2"
  }
}
