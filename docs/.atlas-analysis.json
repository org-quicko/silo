    "GET|POST /api/projects/{project}/envs/{env}/collections",
    "GET|PUT|DELETE /api/projects/{project}/envs/{env}/collections/{name}/schema",
    "GET|POST /api/projects/{project}/envs/{env}/collections/{name}",
    "GET|PUT|DELETE /api/projects/{project}/envs/{env}/collections/{name}/{id}",
    "GET /api/export",
