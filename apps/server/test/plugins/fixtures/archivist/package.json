{
  "name": "archivist",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "silo": {
    "silo": "*",
    "contributes": {
      "hooks": [
        "collection.afterDelete"
      ]
    },
    "permissions": {
      "required": [
        {
          "claim": "collections:*/*/*:entries:create",
          "reason": "To write one row per collection erased, which is the whole fixture."
        }
      ]
    }
  }
}
