{
  "name": "mirror",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "silo": {
    "silo": "*",
    "kind": "extension",
    "hooks": [
      "entry.afterWrite"
    ],
    "claims": [
      "collections:*/*/*:entries:create"
    ],
    "config": {
      "type": "object",
      "properties": {
        "into": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
